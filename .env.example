# ==========================================
# VIREON — Environment Configuration Template
# ==========================================

# PostgreSQL Database (e.g. Supabase / RDS)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Backend Server Configuration
PORT=5001
NODE_ENV=development
API_BASE_URL="http://localhost:5001"
NEXT_PUBLIC_API_URL="http://localhost:5001"

# Razorpay Test Mode Credentials
RAZORPAY_ENVIRONMENT=test
RAZORPAY_MODE=sandbox
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_test_webhook_secret"

# Merchant Display Settings
NEXT_PUBLIC_MERCHANT_NAME="VIREON Technologies India"
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# Optional AI Analysis Key
GEMINI_API_KEY=""
